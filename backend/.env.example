# Copy to .env and adjust as needed. All values shown are the defaults.

# Where the CSV grid data lives (consumers, pmt_monthly, feeder_monthly,
# monthly_readings, track2_features).
ISTIKSHAF_DATA_DIR=./data

# Where trained model artifacts / the SQLite DB are cached.
ISTIKSHAF_CACHE_DIR=./.cache

# CORS: comma-separated list of allowed frontend origins.
ISTIKSHAF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Calibrated-probability threshold above which a consumer becomes an investigation.
ISTIKSHAF_RISK_THRESHOLD=0.55

# Force a retrain on startup even if a cached model exists (true/false).
ISTIKSHAF_FORCE_RETRAIN=false

# The month the dashboard treats as "now" (must exist in the data).
# Defaults to the latest month present in monthly_readings.csv.
ISTIKSHAF_ANALYSIS_MONTH=
